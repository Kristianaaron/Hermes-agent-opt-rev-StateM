+        "Skill instructions: detect errors, failures, exceptions, and timeout behavior."
+    ) is False
+
+
+def test_structured_success_beats_nonfatal_error_text():
+    assert _failed_result(json.dumps({"ok": True, "error": "non-fatal warning"})) is False
