+            if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Attribute):
+                continue
+            owner = node.func.value
+            if not (
+                isinstance(owner, ast.Name)
+                and owner.id == "subprocess"
+                and node.func.attr in {"run", "check_call", "check_output"}
+                and node.args
